# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Credentials (Required for Database and Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Auth Middleware
JWT_SECRET=your_jwt_secret_key_here

# Scheduler Configuration
# Default is '0 0 * * *' (midnight every day)
SCHEDULER_CRON_EXPRESSION=0 0 * * *
ENABLE_SCHEDULER=true

# Upstash Redis (Optional for OTP verification)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP Email Configuration (Optional for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
